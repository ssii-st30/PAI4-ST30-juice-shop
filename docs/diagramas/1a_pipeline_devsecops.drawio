int x="585" y="147"/><mxPoint x="585" y="360"/></Array></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sca" target="dast"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="267"/><mxPoint x="585" y="360"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iac" target="dast"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="387"/><mxPoint x="585" y="360"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="img" target="dast"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="507"/><mxPoint x="585" y="360"/></Array></mxGeometry></mxCell><mxCell id="e12" value="siempre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dast" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="pasa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="dep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="falla: se detiene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="notif"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dd" value="&lt;b&gt;DefectDojo (Kali en VirtualBox de C, expuesto con ngrok)&lt;/b&gt;&lt;br&gt;Producto «Juice Shop ST-30» · engagement CI/CD por rama · importación por API v2 (reimport-scan) con la acción defectdojo-import&lt;br&gt;Deduplica, clasifica y prioriza; cierra (Mitigated) lo que ya no aparece. Si no responde: aviso y el pipeline sigue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="1080" height="90" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#82b366;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sast" target="dd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="171"/><mxPoint x="240" y="745"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#82b366;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sca" target="dd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="291"/><mxPoint x="240" y="745"/></Array></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#82b366;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iac" target="dd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="411"/><mxPoint x="240" y="745"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#82b366;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="img" target="dd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="531"/><mxPoint x="240" y="745"/></Array></mxGeometry></mxCell><mxCell id="e19" value="informe por API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dast" target="dd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;Leyenda:&lt;/b&gt; &amp;nbsp;amarillo = etapa en modo aviso (continue-on-error: informa y el pipeline sigue) · rojo = quality gate bloqueante · azul = build y despliegue · verde = gestión de vulnerabilidades · línea discontinua verde = envío automático del informe a DefectDojo · (A)/(B)/(C) = responsable" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="1310" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
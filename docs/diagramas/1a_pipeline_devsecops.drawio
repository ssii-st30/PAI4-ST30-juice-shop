<mxfile host="app.diagrams.net"><diagram name="1a-pipeline" id="1a-pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Diagrama 1.a – Pipeline DevSecOps de ST-30 (GitHub Actions · OWASP Juice Shop)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="s1" value="Commit y build (análisis estático)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="340" height="590" as="geometry"/></mxCell><mxCell id="s2" value="Pruebas (entorno efímero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="250" height="590" as="geometry"/></mxCell><mxCell id="s3" value="Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="230" height="590" as="geometry"/></mxCell><mxCell id="s4" value="Producción" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#555555;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1140" y="60" width="190" height="590" as="geometry"/></mxCell><mxCell id="trig" value="&lt;b&gt;Push o pull request&lt;/b&gt;&lt;br&gt;master · feature/**&lt;br&gt;(también manual)" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="160" height="80" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;Build (A)&lt;/b&gt;&lt;br&gt;npm install +&lt;br&gt;package-lock.json&lt;br&gt;_build.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="140" height="90" as="geometry"/></mxCell><mxCell id="sast" value="&lt;b&gt;SAST · Semgrep CE (A)&lt;/b&gt;&lt;br&gt;Informe: semgrep.json&lt;br&gt;Aviso si severidad ERROR (alta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="100" width="300" height="95" as="geometry"/></mxCell><mxCell id="sca" value="&lt;b&gt;SCA · Dependency-Check (A)&lt;/b&gt;&lt;br&gt;Informe: dependency-check-report.xml&lt;br&gt;Aviso si CVSS ≥ 7 (alta/crítica)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="220" width="300" height="95" as="geometry"/></mxCell><mxCell id="iac" value="&lt;b&gt;IaC · KICS (B)&lt;/b&gt;&lt;br&gt;Dockerfile, Terraform, compose, k8s&lt;br&gt;Informe: results.json&lt;br&gt;Aviso si Critical o High" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="340" width="300" height="95" as="geometry"/></mxCell><mxCell id="img" value="&lt;b&gt;Imagen · build + GHCR + Trivy (B)&lt;/b&gt;&lt;br&gt;Informe: trivy-image.json&lt;br&gt;Aviso si Critical o High" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="460" width="300" height="95" as="geometry"/></mxCell><mxCell id="dast" value="&lt;b&gt;DAST · ZAP (C)&lt;/b&gt;&lt;br&gt;nuestra imagen de GHCR&lt;br&gt;atacada en localhost&lt;br&gt;Informe: zap-report.xml&lt;br&gt;Aviso si riesgo High" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="615" y="300" width="220" height="120" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Quality gate final (B)&lt;/b&gt;&lt;br&gt;BLOQUEANTE&lt;br&gt;Descarga los 5 artifacts report-*&lt;br&gt;Falla si hay ≥ 1 Critical o High&lt;br&gt;o si falta algún informe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="895" y="280" width="200" height="160" as="geometry"/></mxCell><mxCell id="dep" value="&lt;b&gt;Despliegue (B)&lt;/b&gt;&lt;br&gt;clúster kind efímero&lt;br&gt;solo si el gate pasa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1155" y="315" width="160" height="90" as="geometry"/></mxCell><mxCell id="notif" value="&lt;b&gt;Aviso al equipo&lt;/b&gt;&lt;br&gt;issue en GitHub (uno por rama)&lt;br&gt;con mención al autor&lt;br&gt;+ email de GitHub y resumen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="895" y="490" width="200" height="100" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trig" target="build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;
<mxfile host="app.diagrams.net"><diagram name="1b-flujo-vulnerabilidad" id="1b-flujo-vulnerabilidad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Diagrama 1.b – Qué ocurre cuando una herramienta detecta una vulnerabilidad" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Una herramienta detecta un hallazgo&lt;/b&gt;&lt;br&gt;SAST, SCA, IaC, imagen o DAST" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="260" height="70" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Genera su informe&lt;/b&gt;&lt;br&gt;artifact report-* (JSON/XML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="260" height="60" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Importación automática a DefectDojo&lt;/b&gt;&lt;br&gt;API v2 reimport · deduplica y clasifica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="260" height="70" as="geometry"/></mxCell><mxCell id="d1" value="¿Supera el umbral de la herramienta? (Critical/High)" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="350" width="240" height="120" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Queda registrado en DefectDojo&lt;/b&gt;&lt;br&gt;para priorizarlo; el pipeline continúa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="375" width="260" height="70" as="geometry"/></mxCell><mxCell id="d2" value="¿La etapa es bloqueante?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="240" height="120" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Modo aviso&lt;/b&gt;&lt;br&gt;anotación ⚠ y resumen en el job;&lt;br&gt;el pipeline continúa hasta el gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="250" height="80" as="geometry"/></mxCell><mxCell id="d3" value="Gate final: ¿quedan Critical o High activos?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="650" width="240" height="120" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;El gate pasa&lt;/b&gt;&lt;br&gt;se despliega" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="670" width="200" height="80" as="geometry"/></mxCell><mxCell id="stop" value="&lt;b&gt;El pipeline se detiene&lt;/b&gt;&lt;br&gt;no se despliega" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="260" height="70" as="geometry"/></mxCell><mxCell id="notif" value="&lt;b&gt;Se avisa&lt;/b&gt;&lt;br&gt;email de GitHub al autor del commit&lt;br&gt;+ resumen del job para el equipo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="800" width="260" height="70" as="geometry"/></mxCell><mxCell id="d4" value="Triaje en DefectDojo: ¿es un falso positivo?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="900" width="240" height="120" as="geometry"/></mxCell><mxCell id="fp" value="&lt;b&gt;Falso positivo&lt;/b&gt;&lt;br&gt;se marca en DefectDojo con la justificación&lt;br&gt;y se suprime en la herramienta (por PR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="920" width="260" height="80" as="geometry"/></mxCell><mxCell id="d5" value="¿Se corrige ahora?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1050" width="240" height="120" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Se corrige el código o la configuración&lt;/b&gt;&lt;br&gt;en una rama + pull request revisado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="1070" width="260" height="80" as="geometry"/></mxCell><mxCell id="acc" value="&lt;b&gt;Riesgo aceptado&lt;/b&gt;&lt;br&gt;Risk Acceptance en DefectDojo con&lt;br&gt;responsable y fecha de revisión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="1070" width="260" height="80" as="geometry"/></mxCell><mxCell id="rerun" value="&lt;b&gt;Nuevo push → el pipeline se repite&lt;/b&gt;&lt;br&gt;al reimportar, DefectDojo cierra (Mitigated)&lt;br&gt;los hallazgos que ya no aparecen" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1200" width="260" height="70" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f3" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="n1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="No (aviso)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source=